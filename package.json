{
  "name": "sealory",
  "productName": "Sealory",
  "description": "Offline certificate and ID card batch printer with verification QR",
  "author": {
    "name": "Muhammad Shahbaz",
    "email": "mrshahbaznns@gmail.com"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none npm run react:dev\" \"npm run electron:dev\"",
    "react:dev": "vite",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.shahbaz.sealory",
    "productName": "Sealory",
    "copyright": "Copyright © 2026 Muhammad Shahbaz",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "appx": {
      "applicationId": "Sealory",
      "displayName": "Sealory",
      "identityName": "MuhammadShahbaz.Sealory",
      "publisher": "CN=82C2C857-730F-4239-B80D-4F1C7E03E8B4",
      "publisherDisplayName": "Muhammad Shahbaz",
      "backgroundColor": "#0f172a",
      "languages": [
        "en-US"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "bwip-js": "^4.5.1",
    "jsbarcode": "^3.11.6",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
